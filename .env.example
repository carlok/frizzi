# Local PostgreSQL and Mailpit defaults for Docker Compose.
DATABASE_URL=postgres://frizzi:frizzi@localhost:5432/frizzi
APP_URL=http://localhost:5173
MAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional development secrets. Set them in .env or in the server environment.
RESEND_API_KEY=
CRON_SECRET=
GEOAPIFY_API_KEY=
GEMINI_API_KEY=

# Optional SMTP relay credentials. Hosts other than localhost use STARTTLS (default port 587).
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional rate-limit settings. Set FRIZZI_TRUST_PROXY=1 only behind a reverse proxy that
# overwrites X-Real-IP or X-Forwarded-For. FRIZZI_RATE_LIMIT_SCALE multiplies the per-IP limits.
FRIZZI_TRUST_PROXY=
FRIZZI_RATE_LIMIT_SCALE=

# Optional paths to the local Typst executable and fonts for PDF invitations.
FRIZZI_TYPST=
FRIZZI_PDF_FONTS=
