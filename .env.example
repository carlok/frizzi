# Valori per PostgreSQL e Mailpit locali avviati con Docker Compose.
DATABASE_URL=postgres://frizzi:frizzi@localhost:5432/frizzi
APP_URL=http://localhost:5173
MAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025

# Segreti facoltativi per lo sviluppo. Impostarli solo in .env o nell'ambiente del server.
RESEND_API_KEY=
CRON_SECRET=
GEOAPIFY_API_KEY=
GEMINI_API_KEY=

# Facoltativi: installazione locale di Typst e font per la lettera PDF.
FRIZZI_TYPST=
FRIZZI_PDF_FONTS=
